# --- SIGMA Cloud account -----------------------------------------------------
SIGMA_EMAIL=you@example.com
SIGMA_PASSWORD=your-sigma-cloud-password
# Or, for Docker secrets, point at a file instead of the value above:
# SIGMA_PASSWORD_FILE=/run/secrets/sigma_password

# --- OAuth client (optional) -------------------------------------------------
# Defaults to the macOS DATA CENTER client baked into the connector. Only set
# these if SIGMA ever rotates them (see tools/extract_client_creds.py).
# SIGMA_CLIENT_ID=
# SIGMA_CLIENT_SECRET=

# --- Behaviour ---------------------------------------------------------------
# Only deliver activities newer than N days on the first run (0 = all history).
SINCE_DAYS=0
# Seconds between cycles in `run`.
POLL_INTERVAL=3600
# Cap downloads per cycle (0 = no cap). A large first backfill is gentler capped.
MAX_DOWNLOADS_PER_CYCLE=50
# Pause between downloads, seconds.
DOWNLOAD_DELAY_SECONDS=0.5
# skip | overwrite when the .tcx already sits in the watch folder.
ON_CONFLICT=skip
# debug | info | warning | error
LOG_LEVEL=info

# Paths inside the container (leave as-is unless you remap the volumes).
WATCH_DIR=/watch
STATE_DIR=/state
TOKEN_DIR=/tokens
