# All variables are prefixed SIGMA_CONNECTOR_ so they never collide with
# Dreeve's own env when both share an env_file.

# --- SIGMA Cloud account -----------------------------------------------------
SIGMA_CONNECTOR_EMAIL=you@example.com
SIGMA_CONNECTOR_PASSWORD=your-sigma-cloud-password
# Or, for Docker secrets, point at a file instead of the value above:
# SIGMA_CONNECTOR_PASSWORD_FILE=/run/secrets/sigma_password

# --- OAuth client credentials (required) -------------------------------------
# Not shipped with the connector. Extract them once from your own SIGMA DATA
# CENTER install — see the README section "Getting the client credentials"
# (tools/extract_client_creds.py). Use the MAC pair.
SIGMA_CONNECTOR_CLIENT_ID=
SIGMA_CONNECTOR_CLIENT_SECRET=
# *_FILE variants are also honoured, e.g. SIGMA_CONNECTOR_CLIENT_SECRET_FILE.

# --- Behaviour ---------------------------------------------------------------
# Only deliver activities newer than N days on the first run (0 = all history).
SIGMA_CONNECTOR_SINCE_DAYS=0
# Seconds between cycles in `run`.
SIGMA_CONNECTOR_POLL_INTERVAL=3600
# Cap downloads per cycle (0 = no cap). A large first backfill is gentler capped.
SIGMA_CONNECTOR_MAX_DOWNLOADS_PER_CYCLE=50
# Pause between downloads, seconds.
SIGMA_CONNECTOR_DOWNLOAD_DELAY_SECONDS=0.5
# skip | overwrite when the .tcx already sits in the watch folder.
SIGMA_CONNECTOR_ON_CONFLICT=skip
# debug | info | warning | error
SIGMA_CONNECTOR_LOG_LEVEL=info

# Paths inside the container (leave as-is unless you remap the volumes).
SIGMA_CONNECTOR_WATCH_DIR=/watch
SIGMA_CONNECTOR_STATE_DIR=/state
SIGMA_CONNECTOR_TOKEN_DIR=/tokens
